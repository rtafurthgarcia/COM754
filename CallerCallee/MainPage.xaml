<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CallerCallee.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CallerCallee"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:CallerCallee.ViewModels"
    xmlns:models="using:CallerCallee.Models"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:collections="using:System.Collections.Generic"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Converted -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate x:Name="CallTemplate" x:DataType="models:PhoneCall">
            <Grid Width="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Call #"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Entry.Name}"/>
                <Button Grid.Row="1" Grid.Column="0" IsEnabled="False">
                    <StackPanel>
                        <FontIcon Glyph="&#xEA8C;"/>
                        <TextBlock Text="Caller"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" IsEnabled="False">
                    <StackPanel>
                        <FontIcon Glyph="&#xF8B2;"/>
                        <TextBlock Text="Callee"/>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Top" ColumnSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <CommandBar Grid.Row="1" Grid.ColumnSpan="2" DefaultLabelPosition="Right" 
                VerticalContentAlignment="Top" HorizontalContentAlignment="Center"
                IsOpen="True" Background="Transparent" IsSticky="True">
            <AppBarButton x:Name="ImportAppBarButton" Icon="OpenFile" Label="Import" 
                    Command="{ x:Bind ViewModel.ImportDatasetCommand}" 
                    CommandParameter="{ x:Bind XamlRoot.ContentIslandEnvironment.AppWindowId }"/>
            <AppBarButton Icon="Account" Label="Log-in" 
                    Command="{ x:Bind ViewModel.AuthenticateCommand}"/>
            <AppBarButton Icon="Play" Label="Run"
                    Command="{ x:Bind ViewModel.RunSimulationCommand}"/>
            <AppBarSeparator />
            <AppBarToggleButton Icon="RepeatAll" Label="Autorun" Command="{x:Bind ViewModel.SetAutorunCommand}"
                  IsChecked="{x:Bind ViewModel.Autorun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <CommandBar.Content>
                <StackPanel Margin="4" Orientation="Vertical">
                    <TextBlock Text="{x:Bind ViewModel.LoadedDatasetMessage, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.DatasetCount, Mode=OneWay}"/>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <!-- TreeView bound to DataSource, using the ItemTemplateSelector -->

        <GridView
            Grid.Row="2"
            Grid.ColumnSpan="2"
            ItemTemplate="{StaticResource CallTemplate}"
            ItemsSource="{x:Bind ViewModel.DataSource}" 
            IsItemClickEnabled="False"
            SelectionMode="None">

            <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Margin" Value="5, 5, 5, 5"/>
            </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="MaxItemsWrapGrid"
                        MaximumRowsOrColumns="2"
                        Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <ProgressBar x:Name="ProgressBarInfinite" Grid.Column="0"
                Grid.ColumnSpan="2" Grid.Row="3"  IsIndeterminate="True" ShowPaused="False" 
                Visibility = "{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Page>