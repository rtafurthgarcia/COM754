<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CallerCallee.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CallerCallee"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:CallerCallee.ViewModels"
    xmlns:models="using:CallerCallee.Models"
    xmlns:sys="using:System"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- DataTemplate for folders -->
        <DataTemplate x:Key="CallTemplate" x:DataType="models:DatasetEntry">
            <TreeViewItem AutomationProperties.Name="{x:Bind Name}"
                ItemsSource="{x:Bind Children}" IsExpanded="True">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Width="20" Symbol="Phone"/>
                    <TextBlock Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Bind Name}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <!-- DataTemplate for files -->
        <DataTemplate x:Key="TurnOfConversationTemplate" x:DataType="models:DatasetEntry">
            <TreeViewItem AutomationProperties.Name="{x:Bind Name}">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Width="20" Symbol="Memo"/>
                    <TextBlock Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Bind Name}"/>
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <!-- Template selector for DatasetEntry types -->
        <models:DatasetEntryTemplateSelector x:Key="DatasetEntryTemplateSelector"
                CallTemplate="{StaticResource CallTemplate}"
                TurnOfConversationTemplate="{StaticResource TurnOfConversationTemplate}" />
    </Page.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <CommandBar Grid.Row="1" Grid.ColumnSpan="2" DefaultLabelPosition="Right" 
                VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                IsOpen="True" Background="Transparent" IsSticky="True">
            <AppBarButton Icon="OpenFile" Label="Open the datasource" 
                    Click="OpenFileAppBarButton_Click"/>
            <AppBarButton Icon="Account" Label="Authenticate" 
                    Command="{ x:Bind ViewModel.AuthenticateCommand}"/>
            <AppBarButton Icon="Play" Label="Start the simulation"
                    Command="{ x:Bind ViewModel.RunSimulationCommand}"/>
            <CommandBar.Content>
                <TextBlock Text="{x:Bind ViewModel.LoadedDatasetMessage, Mode=OneWay}"/>
            </CommandBar.Content>
        </CommandBar>

        <!-- TreeView bound to DataSource, using the ItemTemplateSelector -->
        
        <TreeView ItemsSource="{x:Bind ViewModel.DataSource }" ItemTemplateSelector="{StaticResource DatasetEntryTemplateSelector}"/>


        <ProgressBar x:Name="ProgressBar" Visibility="{x:Bind ViewModel.RunSimulationCommand.IsRunning, Mode=OneWay}" 
                Grid.ColumnSpan="2" Grid.Row="3" Value="{x:Bind ViewModel.Progression, Mode=OneWay}" ShowPaused="False" 
                ShowError="{x:Bind ViewModel.AuthenticateCommand.ExecutionTask.IsFaulted}"/>
        
        <InfoBar IsOpen="{x:Bind ViewModel.AuthenticateCommand.ExecutionTask.IsFaulted}" 
                 Severity="Error" Title="Error" Message="{x:Bind ViewModel.AuthenticateCommand.ExecutionTask.Exception.Message}" />
    </Grid>
</Page>
