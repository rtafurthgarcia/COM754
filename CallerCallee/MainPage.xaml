<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CallerCallee.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CallerCallee"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:CallerCallee.ViewModels"
    xmlns:models="using:CallerCallee.Models"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Converted -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- DataTemplate for folders -->
        <DataTemplate x:Key="CallTemplate" x:DataType="models:DatasetEntry">
            <TreeViewItem AutomationProperties.Name="{x:Bind Name}"
                ItemsSource="{x:Bind Children}" IsExpanded="True">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Width="20" Symbol="Phone"/>
                    <TextBlock Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Bind Name}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <!-- DataTemplate for files -->
        <DataTemplate x:Key="TurnOfConversationTemplate" x:DataType="models:DatasetEntry">
            <TreeViewItem AutomationProperties.Name="{x:Bind Name}">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Width="20" Symbol="Memo"/>
                    <TextBlock Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Bind Name}"/>
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <!-- Template selector for DatasetEntry types -->
        <models:DatasetEntryTemplateSelector x:Key="DatasetEntryTemplateSelector"
                CallTemplate="{StaticResource CallTemplate}"
                TurnOfConversationTemplate="{StaticResource TurnOfConversationTemplate}" />
    </Page.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Top" ColumnSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <CommandBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" DefaultLabelPosition="Right" 
                VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                IsOpen="True" Background="Transparent" IsSticky="True">
            <AppBarButton x:Name="ImportAppBarButton" Icon="OpenFile" Label="Open the datasource" 
                    Command="{ x:Bind ViewModel.ImportDatasetCommand}" 
                    CommandParameter="{ x:Bind XamlRoot.ContentIslandEnvironment.AppWindowId }"/>
            <AppBarButton Icon="Account" Label="Authenticate" 
                    Command="{ x:Bind ViewModel.AuthenticateCommand}"/>
            <AppBarButton Icon="Play" Label="Start the simulation"
                    Command="{ x:Bind ViewModel.RunSimulationCommand}"/>
            <CommandBar.Content>
                <TextBlock Text="{x:Bind ViewModel.LoadedDatasetMessage, Mode=OneWay}"/>
            </CommandBar.Content>
        </CommandBar>

        <CheckBox x:Name="AutorunCheckbox" Grid.Row="1" Grid.Column="2" Content="Autorun" Command="{x:Bind ViewModel.SetAutorunCommand}"
                  IsChecked="{x:Bind ViewModel.Autorun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- TreeView bound to DataSource, using the ItemTemplateSelector -->
        <ScrollView Grid.Row="2" Grid.Column="0">
            <TreeView x:Name="MainTreeView" ItemsSource="{x:Bind ViewModel.DataSource }" SelectionMode="Multiple"
                    ItemTemplateSelector="{StaticResource DatasetEntryTemplateSelector}"/>
        </ScrollView>

        <ProgressBar x:Name="ProgressBarInfinite" Grid.Column="0"
                Grid.ColumnSpan="2" Grid.Row="3"  IsIndeterminate="True" ShowPaused="False" 
                Visibility = "{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Page>