<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CallerCallee.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CallerCallee"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:CallerCallee.ViewModels"
    xmlns:models="using:CallerCallee.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- DataTemplate for folders -->
        <DataTemplate x:Key="CallTemplate" x:DataType="models:DatasetEntry">
            <TreeViewItem AutomationProperties.Name="{x:Bind Name}"
                ItemsSource="{x:Bind Children}" IsExpanded="True">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Width="20" Symbol="Phone"/>
                    <TextBlock Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Bind Name}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <!-- DataTemplate for files -->
        <DataTemplate x:Key="TurnOfConversationTemplate" x:DataType="models:DatasetEntry">
            <TreeViewItem AutomationProperties.Name="{x:Bind Name}">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Width="20" Symbol="Memo"/>
                    <TextBlock Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Bind Name}"/>
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <!-- Template selector for DatasetEntry types -->
        <models:DatasetEntryTemplateSelector x:Key="DatasetEntryTemplateSelector"
            CallTemplate="{StaticResource CallTemplate}"
            TurnOfConversationTemplate="{StaticResource TurnOfConversationTemplate}" />
    </Page.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <CommandBar Grid.Row="1" Grid.ColumnSpan="2" DefaultLabelPosition="Right" 
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                    IsOpen="True" Background="Transparent" IsSticky="True">
            <AppBarButton x:Name="OpenFileAppBarButton" Icon="OpenFile" Label="Open the datasource"/>
            <AppBarButton x:Name="PlayAppBarButton" Icon="Play" Label="Start the simulation"/>
            <CommandBar.Content>
                <TextBlock x:Name="PickedSingleFileTextBlock" Text="No datasource picked"/>
            </CommandBar.Content>
        </CommandBar>

        <!-- TreeView bound to DataSource, using the ItemTemplateSelector -->
        <ScrollView Grid.Row="2" Grid.Column="0">
            <TreeView x:Name="VishingTree" ItemsSource="{x:Bind ViewModel.DataSourceVishing }" ItemTemplateSelector="{StaticResource DatasetEntryTemplateSelector}"/>
        </ScrollView>
        <ScrollView Grid.Row="2" Grid.Column="1">
            <TreeView x:Name="NonVishingTree" ItemsSource="{x:Bind ViewModel.DataSourceNonVishing }" ItemTemplateSelector="{StaticResource DatasetEntryTemplateSelector}" />
        </ScrollView>

        <ProgressBar x:Name="ProgressBar" Visibility="Collapsed" Grid.Row="3" IsIndeterminate="True" ShowPaused="False" ShowError="False" />
    </Grid>
</Page>
