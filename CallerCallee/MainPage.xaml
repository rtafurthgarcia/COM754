<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CallerCallee.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CallerCallee"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:CallerCallee.ViewModels"
    xmlns:models="using:CallerCallee.Models"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Converted -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate x:Name="CallTemplate" x:DataType="viewModels:PhoneCallViewModel">
            <Grid Margin="8" RowSpacing="4" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock TextAlignment="Left" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind x:String.Format('Call #{0}', Id), Mode=OneWay}"/>
                <Button Grid.Row="1" Grid.Column="0" >
                    <StackPanel>
                        <SymbolIcon Symbol="{x:Bind CallerSymbol, Mode=OneWay}"/>
                        <TextBlock Text="Caller"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1">
                    <StackPanel>
                        <SymbolIcon Symbol="{x:Bind CalleeSymbol, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                            <SymbolIcon.RenderTransform>
                                <RotateTransform Angle="180"/>
                            </SymbolIcon.RenderTransform>
                        </SymbolIcon>
                        <TextBlock Text="Callee"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical">
                    <TextBlock Text="IS: "/>
                    <TextBlock Text="{x:Bind Is}" Foreground="{x:Bind GetRightColor(Is), Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Vertical">
                    <TextBlock Text="HUMAN: "/>
                    <TextBlock Text="{x:Bind Human}" Foreground="{x:Bind GetRightColor(Human), Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical">
                    <TextBlock Text="NAIVE: "/>
                    <TextBlock Text="{x:Bind Naive, Mode=OneWay}" Foreground="{x:Bind GetRightColor(Naive), Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Vertical">
                    <TextBlock Text="ENHANCED: "/>
                    <TextBlock Text="{x:Bind Enhanced, Mode=OneWay}" Foreground="{x:Bind GetRightColor(Enhanced), Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="8" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom" 
                    Orientation="Horizontal">
                    <TextBlock Text="State: " Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind State, Mode=OneWay}" Foreground="{x:Bind GetRightColorState(State), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
                <TextBlock TextAlignment="Left" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind x:String.Format('Turn #{0}', CurrentTurnId), Mode=OneWay}"/>
                <TextBlock TextAlignment="Left" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource BodyStrongTextBlockStyle}" Width="180"
                    Text="{x:Bind x:String.Format('Running time: {0}', RealDuration), Mode=OneWay}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" ColumnSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <CommandBar Grid.Row="0" Grid.ColumnSpan="2" DefaultLabelPosition="Right" 
                IsOpen="True" Background="Transparent" IsSticky="True">
            <AppBarButton x:Name="ImportAppBarButton" Icon="OpenFile" Label="Import" 
                    Command="{ x:Bind ViewModel.ImportDatasetCommand}" 
                    CommandParameter="{ x:Bind XamlRoot.ContentIslandEnvironment.AppWindowId }"/>
            <AppBarButton Icon="Account" Label="Log-in" 
                    Command="{ x:Bind ViewModel.AuthenticateCommand}">
            </AppBarButton>
            <AppBarButton Icon="Play" Label="Run"
                    Command="{ x:Bind ViewModel.RunSimulationCommand}"/>
            <AppBarSeparator />
            <AppBarToggleButton Icon="RepeatAll" Label="Autorun" Command="{x:Bind ViewModel.SetAutorunCommand}"
                  IsChecked="{x:Bind ViewModel.Autorun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <CommandBar.Content>
                <StackPanel Margin="4" Orientation="Vertical">
                    <TextBlock Text="{x:Bind ViewModel.LoadedDatasetMessage, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.DatasetCount, Mode=OneWay}"/>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <TabView Grid.Column="1" Grid.ColumnSpan="1" Grid.Row="1" Grid.RowSpan="1" VerticalAlignment="Bottom"
            IsAddTabButtonVisible="False" SelectionChanged="TabViewSelectionChanged">
            <TabView.TabItems>
                <TabViewItem Header="To do" IsClosable="False">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Flag" />
                    </TabViewItem.IconSource>
                </TabViewItem>
                <TabViewItem Header="Completed" IsClosable="False">
                    <InfoBadge Style="{StaticResource AttentionValueInfoBadgeStyle}" HorizontalAlignment="Right" Value="{x:Bind ViewModel.ProgressionCompleted}" />
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE930;" />
                    </TabViewItem.IconSource>
                </TabViewItem>
                <TabViewItem Header="Failed" IsClosable="False">
                    <InfoBadge Style="{StaticResource AttentionValueInfoBadgeStyle}" HorizontalAlignment="Right" Value="{x:Bind ViewModel.ProgressionFailed}" />
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE783;" />
                    </TabViewItem.IconSource>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
        <tv:TableView x:Name="TableView" VerticalAlignment="Top" Grid.Column="1" Grid.ColumnSpan="1" Grid.Row="2" Grid.RowSpan="1"
            ItemsSource="{x:Bind ViewModel.DataSource2, Mode=OneWay}"/>

        <TextBlock Text="Ongoing calls" Grid.Row="1" Grid.RowSpan="1" Grid.ColumnSpan="1" Grid.Column="0" 
            Margin="16, 8, 8, 8" VerticalAlignment="Bottom" Style="{StaticResource TitleTextBlockStyle}"/>
        <GridView Grid.Row="2" Grid.RowSpan="1" Grid.ColumnSpan="1" Grid.Column="0" ItemTemplate="{StaticResource CallTemplate}" ItemsSource="{x:Bind ViewModel.DataSource}" 
            IsItemClickEnabled="False" SelectionMode="None">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="8, 8, 8, 8"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="MaxItemsWrapGrid" MaximumRowsOrColumns="2" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <ProgressBar Grid.Column="0"
            Grid.ColumnSpan="2" Grid.Row="3" IsIndeterminate="True" ShowPaused="False" 
            Visibility="{x:Bind ViewModel.AuthenticateCommand.IsRunning, Mode=OneWay}" />

        <ProgressBar Grid.Column="0"
            Grid.ColumnSpan="2" Grid.Row="3" IsIndeterminate="True" ShowPaused="False" 
            Visibility="{x:Bind ViewModel.ImportDatasetCommand.IsRunning, Mode=OneWay}" />

        <StackPanel Grid.Row="3" Orientation="Vertical" Spacing="8" Grid.Column="1" Grid.ColumnSpan="1"
            Visibility="{x:Bind ViewModel.RunSimulationCommand.IsRunning, Mode=OneWay}" 
            HorizontalAlignment="Stretch">
            <ProgressBar IsIndeterminate="False" ShowPaused="False" 
                Value="{x:Bind ViewModel.Progression, Mode=OneWay}" Margin="0 8 0 0"/>
            <TextBlock Text="{x:Bind ViewModel.ProgressionTitle, Mode=OneWay}" FontSize="16" 
                FontWeight="SemiBold" Margin="0" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>